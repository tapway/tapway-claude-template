{
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "tapway-superpowers@tapway-superpowers": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "git",
        "repo": "forrestchang/andrej-karpathy-skills",
        "url": "https://github.com/multica-ai/andrej-karpathy-skills.git"
      }
    },
    "tapway-superpowers": {
      "source": {
        "source": "git",
        "url": "https://github.com/tapway/tapway-superpowers.git"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(make *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "Bash(git push)",
      "Bash(git worktree *)",
      "Bash(docker compose *)",
      "Bash(alembic *)",
      "Bash(uv *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git reset --hard)",
      "Bash(rm -rf *)",
      "Bash(DROP TABLE*)",
      "Bash(curl * | bash *)"
    ]
  },
  "hooks": {},
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "ALLOW_PROD": "0"
  }
}
