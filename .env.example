# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=[PROJECT_NAME]
APP_VERSION=0.1.0

# ── logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── server (Granian) ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
WORKERS=1

# ── compute device ────────────────────────────────────────────────────────────
DEVICE=auto                  # auto | cpu | cuda | cuda:0 | cuda:1

# ── database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/[PROJECT_NAME]_dev

# ── auth (JWT) ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ── frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── integrations (optional) ───────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxx
# SLACK_DEPLOY_WEBHOOK=https://hooks.slack.com/xxx
